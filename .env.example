NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Keep Server Action IDs and closure encryption consistent across production
# instances/builds. Generate the key with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Use a unique value per deployment that is shared by every instance serving
# that deployment. A CI commit SHA is ideal.
NEXT_DEPLOYMENT_ID=

# Browser-only MapTiler key for MapLibre tile/style requests.
# Restrict this key to the production/dev domains in MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=

# Server-only MapTiler key for geocoding. Never expose this to the browser.
MAPTILER_API_KEY=

# Centralized fallback country for normalizing public salon addresses.
KINGPOS_DEFAULT_COUNTRY=US

# Public website origin for metadata, invitation links and customer download QR.
# NEXT_PUBLIC values require a rebuild after changing them.
NEXT_PUBLIC_APP_URL=https://reylumi.com

# Optional online Windows installer hosted outside the web deployment.
# Use an HTTPS URL to a production installer built for https://reylumi.com.
WINDOWS_POS_DOWNLOAD_URL=
WINDOWS_POS_DOWNLOAD_VERSION=

# Staff invitation emails use Resend. Without these, the app creates the invite
# and shows a copyable link, but it will not send a fallback Supabase magic link.
RESEND_API_KEY=
STAFF_INVITE_EMAIL_FROM=

# Optional transactional phone OTP provider for remote customer history claims.
# Use Supabase Auth phone OTP only after Auth SMS/test OTP is configured.
# QR claims and already-verified phone claims do not require SMS.
REYLUMI_PHONE_OTP_PROVIDER=supabase-auth

# Enable fictional Explore showcase content only in an explicit demo environment.
EXPLORE_ENABLE_DEMO_CONTENT=false

# Server-only business claim verification. Twilio Verify handles SMS and voice
# codes; use one Verify Service with both channels enabled. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_SETTINGS_ENCRYPTION_KEY=
REYLUMI_TWILIO_ACCOUNT_SID=
REYLUMI_TWILIO_AUTH_TOKEN=
REYLUMI_TWILIO_VERIFY_SERVICE_SID=

# Optional stable secret for hashing popup IP frequency identifiers.
ADVERTISING_IP_HASH_SECRET=
# Header overwritten by your trusted proxy; Vercel is detected automatically.
ADVERTISING_TRUSTED_IP_HEADER=x-forwarded-for

# Social anti-spam signing key (32+ random bytes, same key seeded via configure_abuse_security).
ANTISPAM_SIGNING_KEY=
# Vercel daily cleanup endpoint authorization.
CRON_SECRET=

# Optional server-only Campaigns credit purchases and saved-card top-ups.
CAMPAIGN_STRIPE_SECRET_KEY=
CAMPAIGN_STRIPE_WEBHOOK_SECRET=

# Campaign queue scheduler authorization (server-only).
CAMPAIGN_QUEUE_SECRET=
# Market plugin subscriptions (server-only Stripe credentials)
MARKET_STRIPE_SECRET_KEY=
MARKET_STRIPE_WEBHOOK_SECRET=

# Booking Deposit: direct charges on the salon's connected Stripe account.
BOOKING_STRIPE_SECRET_KEY=
BOOKING_STRIPE_WEBHOOK_SECRET=
BOOKING_STRIPE_CONNECT_CLIENT_ID=
NEXT_PUBLIC_BOOKING_STRIPE_PUBLISHABLE_KEY=

# Server-only signing secret for the Supabase Auth Send SMS HTTP hook.
SUPABASE_SEND_SMS_HOOK_SECRET=

# Check Writer: server-only, 32 random bytes as 64 hex characters. Never expose publicly.
CHECK_WRITER_ENCRYPTION_KEY=
# Optional rotation keyring JSON and active key ID; retain historical keys for old checks.
CHECK_WRITER_ENCRYPTION_KEYS=
CHECK_WRITER_ACTIVE_KEY_ID=v1
# Leave false until the combined release has passed backend/provider/device acceptance.
# This does not replace the Market catalog fulfillment_ready gate.
CHECK_WRITER_SALES_ENABLED=false
